# Postgres connection string. Set automatically once you attach a database in
# the Vercel dashboard's Storage tab — for local development, run
# `vercel env pull .env.local` to copy it down. Which var name shows up
# depends on the provider (api/_lib/db.js checks both):
#   - Supabase (Vercel Storage marketplace integration): STORAGE_POSTGRES_URL
#   - Vercel Postgres / Neon: POSTGRES_URL
STORAGE_POSTGRES_URL="postgres://user:password@host:5432/dbname"

# --- Internal CRM (/crm-login) ---

# The one allowed login for the CRM. Pick your own values — set them here for
# local dev and in the Vercel dashboard for production. Never commit real
# values to this file.
CRM_USERNAME=""
CRM_PASSWORD=""

# Random secret used to sign the CRM session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Apollo.io API key, used by the "Sync to Apollo" button and the Apollo
# sent-status sync (daily cron + "Refresh from Apollo" button) in the CRM.
APOLLO_API_KEY=""

# Optional but recommended: random secret Vercel sends back as
# `Authorization: Bearer $CRON_SECRET` when it invokes the daily Apollo status
# sync cron job, so the endpoint can verify the request actually came from
# Vercel Cron. Generate with: openssl rand -base64 32
CRON_SECRET=""
