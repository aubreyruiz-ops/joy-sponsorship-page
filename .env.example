# Postgres connection string. If you attach a Postgres or Neon database to this
# project in the Vercel dashboard (Storage tab), this is set automatically for
# your deployments. For local development, run `vercel env pull .env.local`
# to copy it down, or paste your own connection string below.
POSTGRES_URL="postgres://user:password@host:5432/dbname"

# --- Internal CRM (/crm-login) ---

# The one allowed login for the CRM. Pick your own values — set them here for
# local dev and in the Vercel dashboard for production. Never commit real
# values to this file.
CRM_USERNAME=""
CRM_PASSWORD=""

# Random secret used to sign the CRM session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Apollo.io API key, used by the "Sync to Apollo" button in the CRM.
APOLLO_API_KEY=""
